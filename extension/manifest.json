{
  "manifest_version": 3,
  "name": "Neural Ant RPA Assistant",
  "version": "0.5.0",
  "description": "Find application links, fill supported fields, and locally save and restore application drafts for your review.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "draft-storage.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Neural Ant RPA",
    "default_popup": "popup.html"
  }
}