# Copy to .env and replace all values before running.
APP_ENV=development
NEURAL_ANT_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-another-random-secret

# Local Docker Compose defaults. For Cloud Run, use the Neon pooled PostgreSQL URL.
# Paste the Neon URL from Secret Manager into DATABASE_URL at deploy time.
DATABASE_URL=
POSTGRES_DB=neural_ant
POSTGRES_USER=neural_ant
POSTGRES_PASSWORD=replace-with-a-long-database-password

# Resume files stay outside the repository. For Cloud Run, configure a private GCS bucket.
UPLOAD_DIR=/data/resumes
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=

# Optional OpenAI-compatible model service. No resume text is sent unless the user
# confirms the per-draft consent checkbox in the app.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional outgoing email alerts. Use a dedicated sender/service account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Public ATS boards are added in the app; supported: greenhouse, lever, ashby.
